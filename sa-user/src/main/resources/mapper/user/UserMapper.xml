<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.user.module.user.dao.UserMapper">

    <select id="selectByEmail" resultType="net.lab1024.sa.user.module.user.domain.entity.UserEntity">
        SELECT * FROM t_user WHERE email = #{email}
    </select>

    <select id="selectByPhone" resultType="net.lab1024.sa.user.module.user.domain.entity.UserEntity">
        SELECT * FROM t_user WHERE phone = #{phone}
    </select>
    
    <select id="selectByNickname" resultType="net.lab1024.sa.user.module.user.domain.entity.UserEntity">
        SELECT * FROM t_user WHERE nickname = #{nickname}
    </select>

    <update id="updatePoints">
        UPDATE t_user SET points = points + #{points} WHERE user_id = #{userId}
    </update>

</mapper>
